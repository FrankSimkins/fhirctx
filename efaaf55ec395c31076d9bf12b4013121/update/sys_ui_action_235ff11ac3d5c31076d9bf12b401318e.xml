        <name>Validate Connection</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[(function executeValidateConnection() {
 
    try {
        var validator = new x_1886160_fhir_p_0.FHIRConnectionValidator();
        var res = validator.validate(current.getUniqueValue());
 
        // Collapse the per-check detail into one line so it survives as a single message.
        var lines = [];
        if (res.httpStatus !== null) {
            lines.push('HTTP ' + res.httpStatus);
        }
        for (var i = 0; i < res.details.length; i++) {
            lines.push(res.details[i]);
        }
        var detail = lines.join('  |  ');
 
        if (res.ok) {
            gs.addInfoMessage(res.summary + (detail ? ('   [' + detail + ']') : ''));
        } else {
            gs.addErrorMessage(res.summary);
            if (detail) {
                gs.addInfoMessage(detail);
            }
        }
    } catch (e) {
        gs.addErrorMessage('Validate Connection could not run: ' + e.message);
    }
 
})();]]></script>
