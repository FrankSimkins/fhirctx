        <script><![CDATA[function openFhirPatientContext() {
    var mrn = '';
    try {
        mrn = g_form.getValue('u_mrn');
    } catch (e) {
        mrn = '';
    }
    if (!mrn) {
        mrn = prompt('Enter MRN to look up:', '6931');
    }
    if (!mrn) {
        return false;
    }

    var gm = new GlideModal('x_1886160_fhir_p_0_fhir_patient_context', false, 760);
    gm.setTitle('Patient Context');
    gm.setPreference('sysparm_mrn', mrn);
    gm.render();
    return false;
}]]></script>
